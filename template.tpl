setup: |-
  const Object = require('Object');
  const decodeUriComponent = require('decodeUriComponent');
  const sha256Sync = require('sha256Sync');
  const baseData = {
    matomoUrl: 'https://matomo.example.com/',
    tokenAuth: 'tok123',
    idSite: '',
    consentSource: 'auto',
    consentValue: '',
    stripUidOnDenied: true,
    excludedEvents: 'session_start, first_visit, user_engagement',
    eventCategory: '',
    eventAction: '',
    eventName: '',
    eventValue: '',
    searchCategoryKey: '',
    searchCountKey: '',
    goals: [],
    dimensions: [],
    cartItems: '',
    sendProductViews: false,
    overrides: [],
    removeParams: ''
  };
  function withData(extra) {
    const d = {};
    Object.keys(baseData).forEach(function (k) { d[k] = baseData[k]; });
    Object.keys(extra || {}).forEach(function (k) { d[k] = extra[k]; });
    return d;
  }
  function parseBody(body) {
    const params = {};
    body.split('&').forEach(function (pair) {
      const i = pair.indexOf('=');
      params[decodeUriComponent(pair.substring(0, i))] = decodeUriComponent(pair.substring(i + 1));
    });
    return params;
  }
  function run(eventData, extra, status) {
    const requests = [];
    mock('getAllEventData', eventData);
    mock('sendHttpRequest', function (url, cb, options, body) {
      requests.push({ url: url, options: options, body: body, params: parseBody(body) });
      cb(status || 204, {}, '');
    });
    runCode(withData(extra));
    return requests;
  }
  function replayEvent(hitExtra) {
    const hit = { idsite: '1', rec: '1', url: 'https://www.example.com/', _id: '0123456789abcdef' };
    Object.keys(hitExtra).forEach(function (k) { hit[k] = hitExtra[k]; });
    return {
      event_name: 'page_view',
      'x-matomo-hit': hit,
      'x-matomo-idsite': '1',
      ip_override: '203.0.113.9',
      user_agent: 'UA-X',
      language: 'fr-FR'
    };
  }
  function ga4Event(extra) {
    const ev = {
      client_id: '123.456',
      ga_session_id: '789',
      page_location: 'https://www.example.com/p',
      page_title: 'Page',
      page_referrer: 'https://google.com/',
      ip_override: '203.0.113.9',
      user_agent: 'UA-X',
      language: 'fr-fr',
      screen_resolution: '1920x1080'
    };
    Object.keys(extra).forEach(function (k) { ev[k] = extra[k]; });
    return ev;
  }


