___TESTS___

scenarios:
- name: replays a Matomo hit losslessly with plugin parameters
  code: |-
    const r = run(replayEvent({ fa_id: 'f1', fa_fields: '[{"fn":"email"}]', send_image: '0' }));
    assertThat(r.length).isEqualTo(1);
    assertThat(r[0].url).isEqualTo('https://matomo.example.com/matomo.php');
    assertThat(r[0].options.method).isEqualTo('POST');
    assertThat(r[0].params.fa_id).isEqualTo('f1');
    assertThat(r[0].params.fa_fields).isEqualTo('[{"fn":"email"}]');
    assertThat(r[0].params.cip).isEqualTo('203.0.113.9');
    assertThat(r[0].params.ua).isEqualTo('UA-X');
    assertThat(r[0].params.lang).isEqualTo('fr-FR');
    assertThat(r[0].params.token_auth).isEqualTo('tok123');
    assertThat(r[0].body.indexOf('send_image=0')).isEqualTo(r[0].body.lastIndexOf('send_image=0'));
    assertApi('gtmOnSuccess').wasCalled();
- name: token_auth never appears in the URL
  code: |-
    const r = run(replayEvent({}));
    assertThat(r[0].url.indexOf('token')).isEqualTo(-1);
- name: forwards request context headers
  code: |-
    const ev = replayEvent({});
    ev['x-matomo-request'] = { referer: 'https://www.example.com/', dnt: '1', ignore_cookie: '*' };
    const r = run(ev);
    assertThat(r[0].options.headers['referer']).isEqualTo('https://www.example.com/');
    assertThat(r[0].options.headers['dnt']).isEqualTo('1');
    assertThat(r[0].options.headers['Cookie']).isEqualTo('matomo_ignore=*');
    assertThat(r[0].options.headers['User-Agent']).isEqualTo('UA-X');
    assertThat(r[0].options.headers['Content-Type']).isEqualTo('application/x-www-form-urlencoded; charset=UTF-8');
- name: site ID field overrides the hit site ID
