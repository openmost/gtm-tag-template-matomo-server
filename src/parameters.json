[
  {
    "type": "SELECT",
    "name": "trackingType",
    "displayName": "Tracking type",
    "macrosInSelect": false,
    "simpleValueType": true,
    "defaultValue": "auto",
    "selectItems": [
      {
        "value": "auto",
        "displayValue": "Automatic (replay Matomo Client hits, map GA4 events)"
      },
      {
        "value": "event",
        "displayValue": "Matomo event (category, action, name, value set below)"
      }
    ],
    "help": "Automatic: one tag handles every event of the Matomo Client or GA4 client. Matomo event: sends one Matomo event with the values below, for the visitor of the incoming event; create one tag per event you need."
  },
  {
    "type": "TEXT",
    "name": "matomoUrl",
    "displayName": "Matomo instance URL",
    "simpleValueType": true,
    "help": "Base URL of your Matomo instance, e.g. https://analytics.example.com",
    "valueValidators": [
      {
        "type": "NON_EMPTY"
      },
      {
        "type": "REGEX",
        "args": [
          "^https?://.+"
        ]
      }
    ]
  },
  {
    "type": "TEXT",
    "name": "tokenAuth",
    "displayName": "Auth token (token_auth)",
    "simpleValueType": true,
    "help": "Token of a user with at least write access to the site. Required to send the real visitor IP (cip). Sent in the POST body only.",
    "valueValidators": [
      {
        "type": "NON_EMPTY"
      }
    ]
  },
  {
    "type": "TEXT",
    "name": "idSite",
    "displayName": "Site ID",
    "simpleValueType": true,
    "help": "Required for GA4 events. Hits from the Matomo Client keep their own site ID, unless the option below is ticked."
  },
  {
    "type": "CHECKBOX",
    "name": "overrideSiteId",
    "checkboxText": "Override the site ID of Matomo Client hits with this site ID",
    "simpleValueType": true,
    "defaultValue": false
  },
  {
    "type": "GROUP",
    "name": "eventGroup",
    "displayName": "Matomo event",
    "groupStyle": "ZIPPY_OPEN",
    "enablingConditions": [
      {
        "paramName": "trackingType",
        "paramValue": "event",
        "type": "EQUALS"
      }
    ],
    "subParams": [
      {
        "type": "TEXT",
        "name": "eventCategory",
        "displayName": "Event category",
        "simpleValueType": true,
        "valueValidators": [
          {
            "type": "NON_EMPTY"
          }
        ]
      },
      {
        "type": "TEXT",
        "name": "eventAction",
        "displayName": "Event action",
        "simpleValueType": true,
        "valueValidators": [
          {
            "type": "NON_EMPTY"
          }
        ]
      },
      {
        "type": "TEXT",
        "name": "eventName",
        "displayName": "Event name (optional)",
        "simpleValueType": true
      },
      {
        "type": "TEXT",
        "name": "eventValue",
        "displayName": "Event value (optional, numeric)",
        "simpleValueType": true
      }
    ]
  },
  {
    "type": "GROUP",
    "name": "consentGroup",
    "displayName": "Consent",
    "groupStyle": "ZIPPY_OPEN",
    "subParams": [
      {
        "type": "SELECT",
        "name": "consentSource",
        "displayName": "Analytics consent source",
        "macrosInSelect": false,
        "selectItems": [
          {
            "value": "auto",
            "displayValue": "Automatic (GA4 consent mode for GA4 events, matomo.js for Matomo Client events)"
          },
          {
            "value": "variable",
            "displayValue": "Variable"
          }
        ],
        "simpleValueType": true,
        "defaultValue": "auto"
      },
      {
        "type": "TEXT",
        "name": "consentValue",
        "displayName": "Consent value (granted / denied, true / false)",
        "simpleValueType": true,
        "enablingConditions": [
          {
            "paramName": "consentSource",
            "paramValue": "variable",
            "type": "EQUALS"
          }
        ]
      },
      {
        "type": "CHECKBOX",
        "name": "stripUidOnDenied",
        "checkboxText": "Also remove the User ID when consent is denied",
        "simpleValueType": true,
        "defaultValue": true
      }
    ]
  },
  {
    "type": "GROUP",
    "name": "ga4Group",
    "displayName": "GA4 events mapping",
    "groupStyle": "ZIPPY_CLOSED",
    "subParams": [
      {
        "type": "TEXT",
        "name": "excludedEvents",
        "displayName": "Events not sent to Matomo (comma-separated)",
        "simpleValueType": true,
        "defaultValue": "session_start, first_visit, user_engagement"
      },
      {
        "type": "TEXT",
        "name": "searchCategoryKey",
        "displayName": "Event data key of the search category",
        "simpleValueType": true
      },
      {
        "type": "TEXT",
        "name": "searchCountKey",
        "displayName": "Event data key of the search results count",
        "simpleValueType": true
      },
      {
        "type": "SIMPLE_TABLE",
        "name": "goals",
        "displayName": "Goals",
        "simpleTableColumns": [
          {
            "defaultValue": "",
            "displayName": "GA4 event name",
            "name": "eventName",
            "type": "TEXT"
          },
          {
            "defaultValue": "",
            "displayName": "Matomo goal ID",
            "name": "goalId",
            "type": "TEXT"
          },
          {
            "defaultValue": "no",
            "displayName": "Use event value as revenue",
            "name": "useValue",
            "type": "SELECT",
            "selectItems": [
              {
                "value": "no",
                "displayValue": "No"
              },
              {
                "value": "yes",
                "displayValue": "Yes"
              }
            ]
          }
        ]
      },
      {
        "type": "SIMPLE_TABLE",
        "name": "dimensions",
        "displayName": "Custom dimensions",
        "simpleTableColumns": [
          {
            "defaultValue": "",
            "displayName": "Event data key",
            "name": "key",
            "type": "TEXT"
          },
          {
            "defaultValue": "",
            "displayName": "Matomo dimension ID",
            "name": "dimensionId",
            "type": "TEXT"
          }
        ]
      },
      {
        "type": "TEXT",
        "name": "cartItems",
        "displayName": "Full cart content (variable returning GA4 items)",
        "simpleValueType": true,
        "help": "Matomo needs the whole cart on every cart update. When set, add_to_cart / remove_from_cart / view_cart also send a Matomo cart update."
      },
      {
        "type": "CHECKBOX",
        "name": "sendProductViews",
        "checkboxText": "Also send view_item / view_item_list as Matomo product/category page views",
        "simpleValueType": true,
        "defaultValue": false
      }
    ],
    "enablingConditions": [
      {
        "paramName": "trackingType",
        "paramValue": "auto",
        "type": "EQUALS"
      }
    ]
  },
  {
    "type": "GROUP",
    "name": "advancedGroup",
    "displayName": "Advanced",
    "groupStyle": "ZIPPY_CLOSED",
    "subParams": [
      {
        "type": "SIMPLE_TABLE",
        "name": "overrides",
        "displayName": "Set or override Matomo parameters",
        "simpleTableColumns": [
          {
            "defaultValue": "",
            "displayName": "Parameter",
            "name": "key",
            "type": "TEXT"
          },
          {
            "defaultValue": "",
            "displayName": "Value",
            "name": "value",
            "type": "TEXT"
          }
        ]
      },
      {
        "type": "TEXT",
        "name": "removeParams",
        "displayName": "Remove Matomo parameters (comma-separated)",
        "simpleValueType": true
      }
    ]
  }
]
